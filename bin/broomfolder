#!/usr/bin/env sh
set -eu

resolve_script_path() {
  target=$1

  while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
      /*) target=$link ;;
      *) target=$(dirname -- "$target")/$link ;;
    esac
  done

  printf '%s\n' "$target"
}

script_path=$(resolve_script_path "$0")
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$repo_dir/broomfolder.py" "$@"
fi

if command -v python >/dev/null 2>&1; then
  exec python "$repo_dir/broomfolder.py" "$@"
fi

printf 'Python 3 is required to run broomfolder.\n' >&2
exit 1
